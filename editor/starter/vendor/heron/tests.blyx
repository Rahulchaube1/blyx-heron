use std::cli;
use heron;

fn check(ok: bool, label: str) {
    if !ok { stderr_line(label); process_exit(1); }
}

fn main() {
    let initial = he_start();
    check(he_status(initial, 0.0, 5.0) == "unseen", "no observations");
    let a = he_observe(initial, 50.0, 10.0);
    let b = he_observe(a, 53.0, 20.0);
    let c = he_observe(b, 53.0, 22.0);
    let d = he_observe(c, 51.0, 23.0);
    let e = he_observe(d, 54.0, 18.0);
    check(at(e, 2) == 2.0 && at(e, 3) == 1.0 && at(e, 4) == 2.0 && at(e, 5) == 2.0, "classify a replay");
    check(he_age(e, 25.0) == 5.0 && he_status(e, 25.0, 5.0) == "current" && he_status(e, 26.0, 5.0) == "late", "duplicate cannot refresh deadline");
    check(he_status(e, 19.0, 5.0) == "invalid" && he_status(e, 22.0, -1.0) == "invalid", "invalid clock");
    check(len(he_observe(a, 2.5, 12.0)) == 0 && len(he_observe([], 3.0, 1.0)) == 0, "malformed sample");
    check(at(he_observe(he_start(), 1000.0, 0.0), 5) == 0.0, "first sample establishes baseline");
    println!("heron checks passed");
}
